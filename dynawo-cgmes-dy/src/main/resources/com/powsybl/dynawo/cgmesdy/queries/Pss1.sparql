PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:Pss1 .
  OPTIONAL { ?id cim:PowerSystemStabilizerDynamics.ExcitationSystemDynamics ?excitationSystemId . }
  OPTIONAL { ?id cim:WindTurbineType3or4Dynamics.WindPlantDynamics     ?powerPlantId            . }
  OPTIONAL { ?id cim:Pss1.kf ?kf . }
  OPTIONAL { ?id cim:Pss1.komega ?komega . }
  OPTIONAL { ?id cim:Pss1.kw ?komega . }
  OPTIONAL { ?id cim:Pss1.kpe ?kpe . }
  OPTIONAL { ?id cim:Pss1.ks ?ks . }
  OPTIONAL { ?id cim:Pss1.pmin ?pmin . }
  OPTIONAL { ?id cim:Pss1.t5 ?t5 . }
  OPTIONAL { ?id cim:Pss1.t6 ?t6 . }
  OPTIONAL { ?id cim:Pss1.t7 ?t7 . }
  OPTIONAL { ?id cim:Pss1.t8 ?t8 . }
  OPTIONAL { ?id cim:Pss1.t9 ?t9 . }
  OPTIONAL { ?id cim:Pss1.t10 ?t10 . }
  OPTIONAL { ?id cim:Pss1.tpe ?tpe . }
  OPTIONAL { ?id cim:Pss1.vadat ?vadat . }
  OPTIONAL { ?id cim:Pss1.vsmn ?vsmn . }
  OPTIONAL { ?id cim:Pss1.vsmx ?vsmx . }
}
