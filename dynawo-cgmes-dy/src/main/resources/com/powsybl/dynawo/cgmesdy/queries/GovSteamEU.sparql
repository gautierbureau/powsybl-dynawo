PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:GovSteamEU .
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:GovSteamEU.chc ?chc . }
  OPTIONAL { ?id cim:GovSteamEU.cho ?cho . }
  OPTIONAL { ?id cim:GovSteamEU.cic ?cic . }
  OPTIONAL { ?id cim:GovSteamEU.cio ?cio . }
  OPTIONAL { ?id cim:GovSteamEU.db1 ?db1 . }
  OPTIONAL { ?id cim:GovSteamEU.db2 ?db2 . }
  OPTIONAL { ?id cim:GovSteamEU.hhpmax ?hhpmax . }
  OPTIONAL { ?id cim:GovSteamEU.ke ?ke . }
  OPTIONAL { ?id cim:GovSteamEU.kfcor ?kfcor . }
  OPTIONAL { ?id cim:GovSteamEU.khp ?khp . }
  OPTIONAL { ?id cim:GovSteamEU.klp ?klp . }
  OPTIONAL { ?id cim:GovSteamEU.komegacor ?komegacor . }
  OPTIONAL { ?id cim:GovSteamEU.kwcor ?komegacor . }
  OPTIONAL { ?id cim:GovSteamEU.mwbase ?mwbase . }
  OPTIONAL { ?id cim:GovSteamEU.pmax ?pmax . }
  OPTIONAL { ?id cim:GovSteamEU.prhmax ?prhmax . }
  OPTIONAL { ?id cim:GovSteamEU.simx ?simx . }
  OPTIONAL { ?id cim:GovSteamEU.tb ?tb . }
  OPTIONAL { ?id cim:GovSteamEU.tdp ?tdp . }
  OPTIONAL { ?id cim:GovSteamEU.ten ?ten . }
  OPTIONAL { ?id cim:GovSteamEU.tf ?tf . }
  OPTIONAL { ?id cim:GovSteamEU.tfp ?tfp . }
  OPTIONAL { ?id cim:GovSteamEU.thp ?thp . }
  OPTIONAL { ?id cim:GovSteamEU.tip ?tip . }
  OPTIONAL { ?id cim:GovSteamEU.tlp ?tlp . }
  OPTIONAL { ?id cim:GovSteamEU.tp ?tp . }
  OPTIONAL { ?id cim:GovSteamEU.trh ?trh . }
  OPTIONAL { ?id cim:GovSteamEU.tvhp ?tvhp . }
  OPTIONAL { ?id cim:GovSteamEU.tvip ?tvip . }
  OPTIONAL { ?id cim:GovSteamEU.tw ?tw . }
  OPTIONAL { ?id cim:GovSteamEU.wfmax ?wfmax . }
  OPTIONAL { ?id cim:GovSteamEU.wfmin ?wfmin . }
  OPTIONAL { ?id cim:GovSteamEU.wmax1 ?wmax1 . }
  OPTIONAL { ?id cim:GovSteamEU.wmax2 ?wmax2 . }
  OPTIONAL { ?id cim:GovSteamEU.wwmax ?wwmax . }
  OPTIONAL { ?id cim:GovSteamEU.wwmin ?wwmin . }
}
