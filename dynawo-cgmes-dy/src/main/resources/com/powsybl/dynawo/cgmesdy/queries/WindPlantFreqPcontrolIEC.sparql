PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:WindPlantFreqPcontrolIEC .
  OPTIONAL { ?id cim:RotatingMachineDynamics.RotatingMachine          ?synchronousMachineId    . }
  OPTIONAL { ?id cim:AsynchronousMachineDynamics.AsynchronousMachine  ?asynchronousMachineId   . }
  OPTIONAL { ?id cim:ExcitationSystemDynamics.SynchronousMachineDynamics ?excitationSystemId   . }
  OPTIONAL { ?id cim:PowerSystemStabilizerDynamics.ExcitationSystemDynamics ?excitationSystemId . }
  OPTIONAL { ?id cim:WindTurbineType3or4Dynamics.WindPlantDynamics     ?powerPlantId            . }
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.dprefmax ?dprefmax . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.dprefmin ?dprefmin . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.kiwpp ?kiwpp . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.kpwpp ?kpwpp . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.prefmax ?prefmax . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.prefmin ?prefmin . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.tpft ?tpft . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.tpfv ?tpfv . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.twpffilt ?twpffilt . }
  OPTIONAL { ?id cim:WindPlantFreqPcontrolIEC.twppfilt ?twppfilt . }
}
