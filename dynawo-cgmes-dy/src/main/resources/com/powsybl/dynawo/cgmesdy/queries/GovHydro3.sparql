PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:GovHydro3 .
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:GovHydro3.at ?at . }
  OPTIONAL { ?id cim:GovHydro3.db1 ?db1 . }
  OPTIONAL { ?id cim:GovHydro3.db2 ?db2 . }
  OPTIONAL { ?id cim:GovHydro3.dturb ?dturb . }
  OPTIONAL { ?id cim:GovHydro3.eps ?eps . }
  OPTIONAL { ?id cim:GovHydro3.governorControl ?governorControl . }
  OPTIONAL { ?id cim:GovHydro3.gv1 ?gv1 . }
  OPTIONAL { ?id cim:GovHydro3.gv2 ?gv2 . }
  OPTIONAL { ?id cim:GovHydro3.gv3 ?gv3 . }
  OPTIONAL { ?id cim:GovHydro3.gv4 ?gv4 . }
  OPTIONAL { ?id cim:GovHydro3.gv5 ?gv5 . }
  OPTIONAL { ?id cim:GovHydro3.gv6 ?gv6 . }
  OPTIONAL { ?id cim:GovHydro3.h0 ?h0 . }
  OPTIONAL { ?id cim:GovHydro3.k1 ?k1 . }
  OPTIONAL { ?id cim:GovHydro3.k2 ?k2 . }
  OPTIONAL { ?id cim:GovHydro3.kg ?kg . }
  OPTIONAL { ?id cim:GovHydro3.ki ?ki . }
  OPTIONAL { ?id cim:GovHydro3.mwbase ?mwbase . }
  OPTIONAL { ?id cim:GovHydro3.pgv1 ?pgv1 . }
  OPTIONAL { ?id cim:GovHydro3.pgv2 ?pgv2 . }
  OPTIONAL { ?id cim:GovHydro3.pgv3 ?pgv3 . }
  OPTIONAL { ?id cim:GovHydro3.pgv4 ?pgv4 . }
  OPTIONAL { ?id cim:GovHydro3.pgv5 ?pgv5 . }
  OPTIONAL { ?id cim:GovHydro3.pgv6 ?pgv6 . }
  OPTIONAL { ?id cim:GovHydro3.pmax ?pmax . }
  OPTIONAL { ?id cim:GovHydro3.pmin ?pmin . }
  OPTIONAL { ?id cim:GovHydro3.qnl ?qnl . }
  OPTIONAL { ?id cim:GovHydro3.relec ?relec . }
  OPTIONAL { ?id cim:GovHydro3.rgate ?rgate . }
  OPTIONAL { ?id cim:GovHydro3.td ?td . }
  OPTIONAL { ?id cim:GovHydro3.tf ?tf . }
  OPTIONAL { ?id cim:GovHydro3.tp ?tp . }
  OPTIONAL { ?id cim:GovHydro3.tt ?tt . }
  OPTIONAL { ?id cim:GovHydro3.tw ?tw . }
  OPTIONAL { ?id cim:GovHydro3.velcl ?velcl . }
  OPTIONAL { ?id cim:GovHydro3.velop ?velop . }
}
