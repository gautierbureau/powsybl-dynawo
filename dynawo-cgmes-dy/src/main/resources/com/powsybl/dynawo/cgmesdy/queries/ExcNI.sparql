PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:ExcNI .
  OPTIONAL { ?id cim:ExcitationSystemDynamics.SynchronousMachineDynamics ?synchronousMachineId . }
  OPTIONAL { ?id cim:ExcNI.busFedSelector ?busFedSelector . }
  OPTIONAL { ?id cim:ExcNI.ka ?ka . }
  OPTIONAL { ?id cim:ExcNI.kf ?kf . }
  OPTIONAL { ?id cim:ExcNI.r ?r . }
  OPTIONAL { ?id cim:ExcNI.ta ?ta . }
  OPTIONAL { ?id cim:ExcNI.tf1 ?tf1 . }
  OPTIONAL { ?id cim:ExcNI.tf2 ?tf2 . }
  OPTIONAL { ?id cim:ExcNI.tr ?tr . }
  OPTIONAL { ?id cim:ExcNI.vrmax ?vrmax . }
  OPTIONAL { ?id cim:ExcNI.vrmin ?vrmin . }
}
