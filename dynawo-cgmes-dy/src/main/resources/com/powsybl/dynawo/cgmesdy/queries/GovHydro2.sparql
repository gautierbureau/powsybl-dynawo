PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:GovHydro2 .
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:GovHydro2.aturb ?aturb . }
  OPTIONAL { ?id cim:GovHydro2.bturb ?bturb . }
  OPTIONAL { ?id cim:GovHydro2.db1 ?db1 . }
  OPTIONAL { ?id cim:GovHydro2.db2 ?db2 . }
  OPTIONAL { ?id cim:GovHydro2.eps ?eps . }
  OPTIONAL { ?id cim:GovHydro2.gv1 ?gv1 . }
  OPTIONAL { ?id cim:GovHydro2.gv2 ?gv2 . }
  OPTIONAL { ?id cim:GovHydro2.gv3 ?gv3 . }
  OPTIONAL { ?id cim:GovHydro2.gv4 ?gv4 . }
  OPTIONAL { ?id cim:GovHydro2.gv5 ?gv5 . }
  OPTIONAL { ?id cim:GovHydro2.gv6 ?gv6 . }
  OPTIONAL { ?id cim:GovHydro2.kturb ?kturb . }
  OPTIONAL { ?id cim:GovHydro2.mwbase ?mwbase . }
  OPTIONAL { ?id cim:GovHydro2.pgv1 ?pgv1 . }
  OPTIONAL { ?id cim:GovHydro2.pgv2 ?pgv2 . }
  OPTIONAL { ?id cim:GovHydro2.pgv3 ?pgv3 . }
  OPTIONAL { ?id cim:GovHydro2.pgv4 ?pgv4 . }
  OPTIONAL { ?id cim:GovHydro2.pgv5 ?pgv5 . }
  OPTIONAL { ?id cim:GovHydro2.pgv6 ?pgv6 . }
  OPTIONAL { ?id cim:GovHydro2.pmax ?pmax . }
  OPTIONAL { ?id cim:GovHydro2.pmin ?pmin . }
  OPTIONAL { ?id cim:GovHydro2.rperm ?rperm . }
  OPTIONAL { ?id cim:GovHydro2.rtemp ?rtemp . }
  OPTIONAL { ?id cim:GovHydro2.tg ?tg . }
  OPTIONAL { ?id cim:GovHydro2.tp ?tp . }
  OPTIONAL { ?id cim:GovHydro2.tr ?tr . }
  OPTIONAL { ?id cim:GovHydro2.tw ?tw . }
  OPTIONAL { ?id cim:GovHydro2.uc ?uc . }
  OPTIONAL { ?id cim:GovHydro2.uo ?uo . }
}
