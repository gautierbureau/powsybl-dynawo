PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:ExcAVR4 .
  OPTIONAL { ?id cim:ExcitationSystemDynamics.SynchronousMachineDynamics ?synchronousMachineId . }
  OPTIONAL { ?id cim:ExcAVR4.imul ?imul . }
  OPTIONAL { ?id cim:ExcAVR4.ka ?ka . }
  OPTIONAL { ?id cim:ExcAVR4.ke ?ke . }
  OPTIONAL { ?id cim:ExcAVR4.kif ?kif . }
  OPTIONAL { ?id cim:ExcAVR4.t1 ?t1 . }
  OPTIONAL { ?id cim:ExcAVR4.t1if ?t1if . }
  OPTIONAL { ?id cim:ExcAVR4.t2 ?t2 . }
  OPTIONAL { ?id cim:ExcAVR4.t3 ?t3 . }
  OPTIONAL { ?id cim:ExcAVR4.t4 ?t4 . }
  OPTIONAL { ?id cim:ExcAVR4.tif ?tif . }
  OPTIONAL { ?id cim:ExcAVR4.vfmn ?vfmn . }
  OPTIONAL { ?id cim:ExcAVR4.vfmx ?vfmx . }
  OPTIONAL { ?id cim:ExcAVR4.vrmn ?vrmn . }
  OPTIONAL { ?id cim:ExcAVR4.vrmx ?vrmx . }
}
