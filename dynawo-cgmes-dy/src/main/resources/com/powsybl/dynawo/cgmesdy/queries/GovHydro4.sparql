PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:GovHydro4 .
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:GovHydro4.at ?at . }
  OPTIONAL { ?id cim:GovHydro4.bgv0 ?bgv0 . }
  OPTIONAL { ?id cim:GovHydro4.bgv1 ?bgv1 . }
  OPTIONAL { ?id cim:GovHydro4.bgv2 ?bgv2 . }
  OPTIONAL { ?id cim:GovHydro4.bgv3 ?bgv3 . }
  OPTIONAL { ?id cim:GovHydro4.bgv4 ?bgv4 . }
  OPTIONAL { ?id cim:GovHydro4.bgv5 ?bgv5 . }
  OPTIONAL { ?id cim:GovHydro4.bmax ?bmax . }
  OPTIONAL { ?id cim:GovHydro4.db1 ?db1 . }
  OPTIONAL { ?id cim:GovHydro4.db2 ?db2 . }
  OPTIONAL { ?id cim:GovHydro4.dturb ?dturb . }
  OPTIONAL { ?id cim:GovHydro4.eps ?eps . }
  OPTIONAL { ?id cim:GovHydro4.gmax ?gmax . }
  OPTIONAL { ?id cim:GovHydro4.gmin ?gmin . }
  OPTIONAL { ?id cim:GovHydro4.gv0 ?gv0 . }
  OPTIONAL { ?id cim:GovHydro4.gv1 ?gv1 . }
  OPTIONAL { ?id cim:GovHydro4.gv2 ?gv2 . }
  OPTIONAL { ?id cim:GovHydro4.gv3 ?gv3 . }
  OPTIONAL { ?id cim:GovHydro4.gv4 ?gv4 . }
  OPTIONAL { ?id cim:GovHydro4.gv5 ?gv5 . }
  OPTIONAL { ?id cim:GovHydro4.hdam ?hdam . }
  OPTIONAL { ?id cim:GovHydro4.mwbase ?mwbase . }
  OPTIONAL { ?id cim:GovHydro4.pgv0 ?pgv0 . }
  OPTIONAL { ?id cim:GovHydro4.pgv1 ?pgv1 . }
  OPTIONAL { ?id cim:GovHydro4.pgv2 ?pgv2 . }
  OPTIONAL { ?id cim:GovHydro4.pgv3 ?pgv3 . }
  OPTIONAL { ?id cim:GovHydro4.pgv4 ?pgv4 . }
  OPTIONAL { ?id cim:GovHydro4.pgv5 ?pgv5 . }
  OPTIONAL { ?id cim:GovHydro4.qn1 ?qn1 . }
  OPTIONAL { ?id cim:GovHydro4.qnl ?qnl . }
  OPTIONAL { ?id cim:GovHydro4.rperm ?rperm . }
  OPTIONAL { ?id cim:GovHydro4.rtemp ?rtemp . }
  OPTIONAL { ?id cim:GovHydro4.tblade ?tblade . }
  OPTIONAL { ?id cim:GovHydro4.tg ?tg . }
  OPTIONAL { ?id cim:GovHydro4.tp ?tp . }
  OPTIONAL { ?id cim:GovHydro4.tr ?tr . }
  OPTIONAL { ?id cim:GovHydro4.tw ?tw . }
  OPTIONAL { ?id cim:GovHydro4.uc ?uc . }
  OPTIONAL { ?id cim:GovHydro4.uo ?uo . }
}
