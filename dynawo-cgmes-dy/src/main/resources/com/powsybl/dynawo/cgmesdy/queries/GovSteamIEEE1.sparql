PREFIX cim:  <%%CIM_NS%%>

PREFIX md:   <http://iec.ch/TC57/61970-552/ModelDescription/1#>

SELECT * WHERE {
  ?id rdf:type cim:GovSteamIEEE1 .
  OPTIONAL { ?id cim:TurbineGovernorDynamics.SynchronousMachineDynamics ?synchronousMachineId  . }
  OPTIONAL { ?id cim:GovSteamIEEE1.mwbase ?mwbase . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k ?k . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t1 ?t1 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t2 ?t2 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t3 ?t3 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.uo ?uo . }
  OPTIONAL { ?id cim:GovSteamIEEE1.uc ?uc . }
  OPTIONAL { ?id cim:GovSteamIEEE1.pmax ?pmax . }
  OPTIONAL { ?id cim:GovSteamIEEE1.pmin ?pmin . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t4 ?t4 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k1 ?k1 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k2 ?k2 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t5 ?t5 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k3 ?k3 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k4 ?k4 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t6 ?t6 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k5 ?k5 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k6 ?k6 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.t7 ?t7 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k7 ?k7 . }
  OPTIONAL { ?id cim:GovSteamIEEE1.k8 ?k8 . }
}
